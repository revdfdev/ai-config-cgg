{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I \"@ROOT@/hooks/prompt-reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I \"@ROOT@/hooks/proof-gate.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
