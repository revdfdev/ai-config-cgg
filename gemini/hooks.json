{
  "ai-config-ccg-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {"type": "command", "command": "@PYTHON@ -I \"@ROOT@/hooks/guard-bash.py\"", "timeout": 10}
        ]
      }
    ]
  },
  "ai-config-ccg-reminder": {
    "PreInvocation": [
      {"type": "command", "command": "@PYTHON@ -I \"@ROOT@/hooks/prompt-reminder.py\" --antigravity", "timeout": 5}
    ]
  },
  "ai-config-ccg-proof-gate": {
    "Stop": [
      {"type": "command", "command": "@PYTHON@ -I \"@ROOT@/hooks/proof-gate.py\"", "timeout": 15}
    ]
  }
}
